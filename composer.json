{
    "name": "microscrap/scrapyard-usb",
    "description": "USB connection drivers for the ScrapyardIO GPIO framework: MPSSE digital, I2C and SPI plus FTDI UART over ext-ftdi",
    "type": "library",
    "version": "0.10.0",
    "keywords": [
        "scrapyard-io",
        "gpio",
        "usb",
        "ftdi",
        "mpsse",
        "drivers"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "ext-ftdi": "^0.10.0",
        "gpio/contracts": "^0.10.0",
        "gpio/digital": "^0.10.0",
        "gpio/i2c": "^0.10.0",
        "gpio/nuts-and-bolts": "^0.10.0",
        "gpio/spi": "^0.10.0",
        "gpio/uart": "^0.10.0",
        "microscrap/mpsse": "^0.10.0",
        "venusian-voyager/nuts-and-bolts": "^0.10.0"
    },
    "require-dev": {
        "pestphp/pest": "^4",
        "venusian-voyager/config": "^0.10.0",
        "venusian-voyager/vessel": "^0.10.0"
    },
    "autoload": {
        "psr-4": {
            "Microscrap\\ScrapyardUSB\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Microscrap\\ScrapyardUSB\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.10.x-dev"
        },
        "venusian": {
            "providers": [
                "Microscrap\\ScrapyardUSB\\Providers\\ScrapyardUSBServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
